{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source-backed default function identities",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "evidence", "grants", "exclusions"],
  "properties": {
    "format": {"const": 1},
    "evidence": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["inventories", "sources", "notes"],
        "properties": {
          "inventories": {"$ref": "#/$defs/strings"},
          "sources": {"type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/(blob|tree)/[0-9a-f]{40}/[^\\s]+$"}},
          "notes": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "grants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["catalog", "schema_path", "type", "evidence", "names"],
        "properties": {
          "catalog": {"const": "system"},
          "schema_path": {"const": ["main"]},
          "type": {"type": "string", "pattern": "^(scalar|aggregate|table|macro|table_macro|window)$"},
          "evidence": {"type": "string", "minLength": 1},
          "names": {"$ref": "#/$defs/strings"}
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence", "reason", "names"],
        "properties": {
          "evidence": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "names": {"$ref": "#/$defs/strings"}
        }
      }
    }
  },
  "$defs": {
    "strings": {"type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}}
  }
}
