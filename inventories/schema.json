{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed Gatekeeper function inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "reviewed_duckdb", "source", "notes", "compute", "elevated"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "reviewed_duckdb": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {"type": "string", "pattern": "^https://[^/\\s]+/[^\\s]+$"},
    "binary_review": {
      "type": "object", "additionalProperties": false, "required": ["version", "sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "notes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "compute": {"$ref": "#/$defs/names"},
    "elevated": {"$ref": "#/$defs/names"},
    "unreviewed": {"$ref": "#/$defs/names"},
    "unreviewed_reason": {"type": "string", "minLength": 1},
    "groups": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/names"}}
  },
  "allOf": [
    {"if": {"properties": {"name": {"const": "motherduck"}}}, "then": {"required": ["binary_review"]},
     "else": {"not": {"required": ["binary_review"]}}},
    {"if": {"properties": {"name": {"const": "core"}}}, "then": {"required": ["groups"]},
     "else": {"not": {"required": ["groups"]}}},
    {"if": {"required": ["unreviewed"], "properties": {"unreviewed": {"minItems": 1}}},
     "then": {"required": ["unreviewed_reason"]}}
  ],
  "$defs": {
    "names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
