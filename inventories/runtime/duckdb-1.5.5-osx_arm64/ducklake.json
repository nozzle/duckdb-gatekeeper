      {
        "catalog": "system",
        "kind": "table_macro",
        "macro": "(SELECT i.snapshot_id, i.rowid, CASE  WHEN ((d.rowid IS NOT NULL)) THEN ('update_postimage') ELSE 'insert' END AS change_type, i.* FROM ducklake_table_insertions(\"catalog\", schema_name, table_name, start_snapshot, end_snapshot) AS i LEFT JOIN ducklake_table_deletions(\"catalog\", schema_name, table_name, start_snapshot, end_snapshot) AS d ON (((i.snapshot_id = d.snapshot_id) AND (i.rowid = d.rowid)))) UNION ALL (SELECT d.snapshot_id, d.rowid, CASE  WHEN ((i.rowid IS NOT NULL)) THEN ('update_preimage') ELSE 'delete' END AS change_type, d.* FROM ducklake_table_deletions(\"catalog\", schema_name, table_name, start_snapshot, end_snapshot) AS d LEFT JOIN ducklake_table_insertions(\"catalog\", schema_name, table_name, start_snapshot, end_snapshot) AS i ON (((d.snapshot_id = i.snapshot_id) AND (d.rowid = i.rowid))))",
        "name": "ducklake_table_changes",
