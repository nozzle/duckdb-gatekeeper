# name: test/sql/pragma_guard.test
# description: With allow_parser_override_extension enabled, PRAGMA statements whose arguments are not constants are refused before DuckDB evaluates them.
# group: [gatekeeper]

require gatekeeper

statement ok
CREATE SEQUENCE s;

# Default posture: the statement preprocessor evaluates the argument before any hook; the sequence advances
# even though the pragma does not exist.

statement error
PRAGMA no_such_pragma(nextval('s'));
----
does not exist

query I
SELECT currval('s');
----
1

statement ok
SET allow_parser_override_extension = 'fallback';

statement error
PRAGMA no_such_pragma(nextval('s'));
----
Gatekeeper denied this statement (unsupported): statement: PRAGMA no_such_pragma has a non-constant argument

statement error
PRAGMA no_such_pragma(seq = nextval('s'));
----
Gatekeeper denied this statement (unsupported): statement: PRAGMA no_such_pragma has a non-constant argument

statement error
PRAGMA no_such_pragma(1 + 1);
----
Gatekeeper denied this statement (unsupported): statement: PRAGMA no_such_pragma has a non-constant argument

query I
SELECT currval('s');
----
1

# Constants, negative numbers, bare identifiers, and assignment pragmas are untouched.

statement error
PRAGMA no_such_pragma(-1, 'two', bare_identifier, x = NULL);
----
does not exist

statement ok
PRAGMA threads = 1;

query I
SELECT count(*) > 0 FROM pragma_version();
----
true

statement ok
PRAGMA version;

# The engine still reports its own parse errors.

statement error
SELEC 1;
----
syntax error at or near "SELEC"

# Strict mode behaves the same.

statement ok
SET allow_parser_override_extension = 'strict';

statement error
PRAGMA no_such_pragma(nextval('s'));
----
Gatekeeper denied this statement (unsupported): statement: PRAGMA no_such_pragma has a non-constant argument

query I
SELECT currval('s');
----
1

# The rewrite target is on the never-bind list, and gatekeeper_validate reports the raw text as before.

query II
SELECT allowed, code FROM gatekeeper_validate('SELECT gatekeeper_rejected_pragma(1)');
----
false	forbidden

query II
SELECT allowed, code FROM gatekeeper_validate('PRAGMA no_such_pragma(nextval(''s''))');
----
false	unsupported

# An enforced connection is refused by the guard, before its own denial would apply.

statement ok
SET enable_external_access = false;

statement ok
SET lock_configuration = true;

query I
SELECT enforced FROM gatekeeper_enforce();
----
true

statement error
PRAGMA no_such_pragma(nextval('s'));
----
Gatekeeper denied this statement (unsupported): statement: PRAGMA no_such_pragma has a non-constant argument

statement error
SELECT currval('s');
----
Gatekeeper denied this statement
