# name: test/sql/tables.test
# description: Table policy: unrestricted default, allow and block rules, wildcards, views, macros, shadowing, SHOW.
# group: [gatekeeper]

require gatekeeper

statement ok
CREATE SCHEMA reporting;

statement ok
CREATE TABLE reporting.orders(customer_id INTEGER, amount DOUBLE);

statement ok
CREATE TABLE reporting.sensitive_orders(customer_id INTEGER, amount DOUBLE);

statement ok
CREATE TABLE secrets(token VARCHAR);

statement ok
CREATE VIEW reporting.totals AS SELECT customer_id, sum(amount) AS total FROM reporting.orders GROUP BY customer_id;

statement ok
CREATE VIEW exposed AS SELECT token FROM secrets;

# Tables and views are unrestricted until allowed_tables is configured (internal objects excepted).
query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM secrets');
----
true

query T
SELECT current_setting('gatekeeper_policy').restrict_tables;
----
false

# An empty allowlist denies every table and view; a rule grants by resolved identity.
query TTTTT
SELECT code, violations[1].rule, violations[1].catalog, violations[1].schema, violations[1]."table" FROM gatekeeper_validate('SELECT * FROM secrets', allowed_tables := []);
----
forbidden	table	memory	main	secrets

query I
SELECT allowed FROM gatekeeper_validate('SELECT 1', allowed_tables := []);
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.orders', allowed_tables := [{catalog: 'memory', schema: 'reporting', 'table': 'orders'}]);
----
true

# Rules match the resolved identity, not how the query spelled it.
query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM memory.reporting.ORDERS AS o', allowed_tables := [{schema: 'reporting', 'table': 'orders'}]);
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': 'orders'}]);
----
forbidden

# Only a whole-component '*' is a wildcard; partial patterns are literal names.
query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': 'sensitive_%'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': '*_orders'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM secrets', allowed_tables := [{catalog: '*', schema: '*', 'table': '*'}]);
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM secrets', allowed_tables := [{catalog: 'warehouse', schema: '*', 'table': '*'}]);
----
forbidden

# Entries do not form a cross-product: each rule pairs its own catalog and schema.
query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.orders', allowed_tables := [{schema: 'main', 'table': '*'}, {schema: 'reporting', 'table': 'totals'}]);
----
forbidden

# A trusted view is opaque to table policy: the view the caller names must pass, and the tables its body reads
# are the view's own. They still appear as evidence.
query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.totals', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]);
----
ok

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.totals', allowed_tables := [{schema: 'reporting', 'table': 'orders'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.totals', allowed_tables := [{schema: 'reporting', 'table': 'totals'}, {schema: 'reporting', 'table': 'orders'}]);
----
true

query TTT
SELECT o.schema, o."table", o.type FROM gatekeeper_validate('SELECT * FROM reporting.totals', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]), unnest(objects) AS u(o) ORDER BY o."table";
----
reporting	orders	table
reporting	totals	view

# The caller's own reference to a table the view reads is the caller's, next to the view or anywhere else.
query TTTT
SELECT code, violations[1].rule, violations[1].schema, violations[1]."table" FROM gatekeeper_validate('SELECT * FROM reporting.totals t JOIN reporting.orders o USING (customer_id)', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]);
----
forbidden	table	reporting	orders

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.totals t JOIN reporting.orders o USING (customer_id)', allowed_tables := [{schema: 'reporting', 'table': 'totals'}, {schema: 'reporting', 'table': 'orders'}]);
----
true

# A view over a view: the caller names the outer one.
statement ok
CREATE VIEW reporting.nested_totals AS SELECT * FROM reporting.totals;

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.nested_totals', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]);
----
forbidden

query TTT
SELECT o.schema, o."table", o.type FROM gatekeeper_validate('SELECT * FROM reporting.nested_totals', allowed_tables := [{schema: 'reporting', 'table': 'nested_totals'}]), unnest(objects) AS u(o) ORDER BY o."table";
----
reporting	nested_totals	view
reporting	orders	table
reporting	totals	view

# Blocks win over allows and apply without any allowlist, to the objects the caller names. What a trusted view
# or macro reads is its own: a block on it reaches the caller's reference, not the definition's.
query TTT
SELECT code, violations[1].rule, violations[1].message FROM gatekeeper_validate('SELECT * FROM secrets', blocked_tables := [{schema: 'main', 'table': 'secrets'}]);
----
forbidden	table	object is blocked

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM exposed', blocked_tables := [{schema: 'main', 'table': 'secrets'}]);
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM exposed, secrets', blocked_tables := [{schema: 'main', 'table': 'secrets'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM exposed', blocked_tables := [{schema: 'main', 'table': 'exposed'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': '*'}], blocked_tables := [{schema: 'reporting', 'table': 'sensitive_orders'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.orders', allowed_tables := [{schema: 'reporting', 'table': '*'}], blocked_tables := [{schema: 'reporting', 'table': 'sensitive_orders'}]);
----
true

statement ok
CREATE MACRO peek() AS TABLE SELECT token FROM secrets;

statement ok
CREATE MACRO secret_count() AS (SELECT count(*) FROM secrets);

statement ok
CALL gatekeeper_configure(allowed_functions := ['peek', 'secret_count']);

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM peek()');
----
true

# The table macro's body binds in its own binder; the scalar macro's subquery binds in the caller's, so the
# objects it reads are recognized from its definition. Either way they are the macro's, unless the caller
# names them too.
query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM peek()', blocked_tables := [{schema: 'main', 'table': 'secrets'}]);
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM peek()', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
true

query TT
SELECT allowed, list_transform(objects, lambda o: o."table") FROM gatekeeper_validate('SELECT secret_count()', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
true	[secrets]

query TTT
SELECT code, violations[1].rule, violations[1]."table" FROM gatekeeper_validate('SELECT secret_count() FROM secrets', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
forbidden	table	secrets

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM peek(), secrets', blocked_tables := [{schema: 'main', 'table': 'secrets'}]);
----
forbidden

# A caller-written CTE a table macro inherits is the caller's text, bound in the caller's scope.
statement ok
CREATE MACRO consume() AS TABLE SELECT * FROM exposed;

statement ok
CALL gatekeeper_configure(allowed_functions := ['peek', 'secret_count', 'consume']);

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM consume()', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
true

query TTT
SELECT code, violations[1].rule, violations[1]."table" FROM gatekeeper_validate('WITH exposed AS (SELECT * FROM secrets) SELECT * FROM consume()', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
forbidden	table	secrets

statement ok
RESET gatekeeper_policy;

# CTE names are not objects; the tables they read are. A CTE named like a table a view reads is not a
# reference to that table; the caller's own FROM of that name is, wherever the name resolves.
query T
SELECT code FROM gatekeeper_validate('WITH orders AS (SELECT * FROM secrets) SELECT * FROM orders', allowed_tables := [{schema: 'main', 'table': 'orders'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('WITH s AS (SELECT * FROM secrets) SELECT * FROM s', allowed_tables := [{schema: 'main', 'table': 'secrets'}]);
----
true

query I
SELECT allowed FROM gatekeeper_validate('WITH orders AS (SELECT 1 AS customer_id) SELECT * FROM reporting.totals', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]);
----
true

query TTT
SELECT code, violations[1].rule, violations[1]."table" FROM gatekeeper_validate('WITH orders AS (SELECT 1 AS customer_id) SELECT * FROM reporting.totals t, orders', allowed_tables := [{schema: 'reporting', 'table': 'totals'}]);
----
forbidden	table	orders

query I
SELECT allowed FROM gatekeeper_validate('WITH orders AS (SELECT 1 AS customer_id) SELECT * FROM reporting.totals t, orders', allowed_tables := [{schema: 'reporting', 'table': 'totals'}, {schema: 'reporting', 'table': 'orders'}]);
----
true

# Subqueries, joins, and set operations are all authorized.
query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.orders WHERE customer_id IN (SELECT length(token) FROM secrets)', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.orders o JOIN secrets s ON o.customer_id = length(s.token)', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT customer_id FROM reporting.orders UNION ALL SELECT length(token) FROM secrets', allowed_tables := [{schema: 'reporting', 'table': '*'}]);
----
forbidden

# The global policy is a ceiling: the request can narrow it but never widen it.
statement ok
CALL gatekeeper_configure(allowed_tables := [{schema: 'reporting', 'table': '*'}]);

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.orders');
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM secrets', allowed_tables := [{schema: 'main', 'table': 'secrets'}]);
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM reporting.sensitive_orders', allowed_tables := [{schema: 'reporting', 'table': 'orders'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM reporting.orders', allowed_tables := [{schema: 'reporting', 'table': 'orders'}]);
----
true

# Schema-wide SHOW is denied whenever a table restriction is configured; DESCRIBE of a table checks it.
query T
SELECT code FROM gatekeeper_validate('SHOW TABLES');
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('DESCRIBE reporting.orders');
----
true

query T
SELECT code FROM gatekeeper_validate('DESCRIBE secrets');
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SUMMARIZE secrets');
----
forbidden

statement ok
RESET gatekeeper_policy;

# Temporary tables shadow by search path and resolve to the temp catalog: explicit catalogs exclude them.
statement ok
CREATE TEMP TABLE orders(customer_id INTEGER);

query TT
SELECT o.catalog, o."table" FROM gatekeeper_validate('SELECT * FROM orders'), unnest(objects) AS u(o);
----
temp	orders

query T
SELECT code FROM gatekeeper_validate('SELECT * FROM orders', allowed_tables := [{catalog: 'memory', schema: '*', 'table': '*'}]);
----
forbidden

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM orders', allowed_tables := [{catalog: '*', schema: '*', 'table': 'orders'}]);
----
true

# Engine errors report their phase; policy denials carry no engine message.
query TTT
SELECT code, error_type, violations[1].rule FROM gatekeeper_validate('SELECT * FROM reporting.missing');
----
binding	Catalog	NULL

query TT
SELECT code, error_message FROM gatekeeper_validate('SELECT * FROM secrets', allowed_tables := []);
----
forbidden	(empty)
