# name: test/sql/statements.test
# description: Only single SELECT statements are validated; every other statement type is unsupported.
# group: [gatekeeper]

require gatekeeper

statement ok
CREATE TABLE t(x INTEGER);

# Statement types are an allowlist: SELECT, plus the temporary enum type DuckDB's own parser derives from a
# dynamic PIVOT. Everything else returns `unsupported` with a `statement` violation before binding, so nothing
# referenced below needs to exist or be reachable.

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('INSERT INTO t VALUES (1)');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('UPDATE t SET x = 1');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('DELETE FROM t');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('MERGE INTO t USING t AS s ON t.x = s.x WHEN MATCHED THEN DELETE');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE TABLE u(x INTEGER)');
----
unsupported	statement

