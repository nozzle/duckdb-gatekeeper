# A dynamic PIVOT is the statements DuckDB rewrites it into: temporary enum types defined by SELECTs the policy
# allows, then the SELECT that names them. Only that exact rewrite is admitted; temporary DDL is not.
query I
SELECT allowed FROM gatekeeper_validate('PIVOT t ON x USING sum(x)');
----
true

query I
SELECT allowed FROM gatekeeper_validate('CREATE OR REPLACE TEMP TYPE "__pivot_enum_0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0" AS ENUM (SELECT DISTINCT CAST(x AS VARCHAR) FROM t WHERE (x IS NOT NULL) ORDER BY 1 ASC)');
----
true

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE OR REPLACE TEMP TYPE "__pivot_enum_0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0" AS ENUM (''a'', ''b'')');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE OR REPLACE TEMP TYPE mood AS ENUM (SELECT DISTINCT x FROM t)');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE TEMP TYPE "__pivot_enum_0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0" AS ENUM (SELECT DISTINCT x FROM t)');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE OR REPLACE TYPE "__pivot_enum_0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0" AS ENUM (SELECT DISTINCT x FROM t)');
----
unsupported	statement

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('CREATE OR REPLACE TEMP TYPE main."__pivot_enum_0f1e2d3c-4b5a-6978-8796-a5b4c3d2e1f0" AS ENUM (SELECT DISTINCT x FROM t)');
----
unsupported	statement

# Multiple statements are a fixed limit, checked before anything binds.
query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('SELECT 1; DROP TABLE t');
----
forbidden	limit

query TT
SELECT code, violations[1].rule FROM gatekeeper_validate('DROP TABLE t; SELECT 1');
----
forbidden	limit

# Empty semicolon segments are ignored by the parser; empty and comment-only input is invalid.
query I
SELECT allowed FROM gatekeeper_validate('SELECT 1;;');
----
true

query I
SELECT allowed FROM gatekeeper_validate(';SELECT 1');
----
true

query T
SELECT code FROM gatekeeper_validate('');
----
invalid_input

query T
SELECT code FROM gatekeeper_validate(';');
----
invalid_input

query T
SELECT code FROM gatekeeper_validate('-- nothing');
----
invalid_input

query T
SELECT code FROM gatekeeper_validate('/* nothing */');
----
invalid_input

query TT
SELECT code, error_type FROM gatekeeper_validate('SELEC 1');
----
parser	parser

# Parameters validate where DuckDB can finish binding without values; a bare untyped parameter cannot.
query I
SELECT allowed FROM gatekeeper_validate('SELECT x FROM t WHERE x = ? LIMIT ?');
----
true

query T
SELECT code FROM gatekeeper_validate('SELECT $1');
----
binding

# Read-only query constructs bind and authorize normally.

query I
SELECT allowed FROM gatekeeper_validate('FROM t');
----
true

query I
SELECT allowed FROM gatekeeper_validate('FROM t SELECT x');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT x FROM t QUALIFY row_number() OVER () = 1');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t POSITIONAL JOIN t AS u');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t ASOF JOIN t AS u ON t.x >= u.x');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t SEMI JOIN t AS u ON t.x = u.x');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT x, count(*) FROM t GROUP BY ROLLUP (x)');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT x FROM t GROUP BY ALL ORDER BY ALL');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT [y FOR y IN [1,2] IF y > 1]');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT ARRAY[1,2]');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t USING SAMPLE 1');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t TABLESAMPLE 10%');
----
true

query I
SELECT allowed FROM gatekeeper_validate('WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT * FROM r');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t, LATERAL (SELECT t.x + 1) AS l(y)');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SELECT * FROM t UNION BY NAME SELECT * FROM t');
----
true

query I
SELECT allowed FROM gatekeeper_validate('SUMMARIZE t');
----
true

query I
SELECT allowed FROM gatekeeper_validate('DESCRIBE t');
----
true

query I
SELECT allowed FROM gatekeeper_validate('DESCRIBE SELECT * FROM t');
----
true

query I
SELECT allowed FROM gatekeeper_validate('PIVOT t ON x IN (1, 2) USING sum(x)');
----
true

query I
SELECT allowed FROM gatekeeper_validate('UNPIVOT t ON x INTO NAME n VALUE v');
----
true

# DuckDB 2.0 parses data-modifying CTEs (WITH d AS (DELETE ...)) that 1.5's parser refuses; their query nodes
# (DELETE_QUERY_NODE, ...) are absent from the grammar's dispatch and fail closed. Refused on both engines:
# a parser error on 1.5, `unsupported` on 2.0. Tighten to the exact code at the 2.0 repin.

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('WITH d AS (DELETE FROM t RETURNING *) SELECT * FROM d');
----
false	true

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('WITH d AS (INSERT INTO t VALUES (1) RETURNING *) SELECT * FROM d');
----
false	true

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('WITH d AS (UPDATE t SET x = 1 RETURNING *) SELECT * FROM d');
----
false	true

# DuckDB 2.0 qualifies names with nested schema paths (a.b.c.name) and writes them as qualified_name next to
# catalog/schema/name properties that are lossy views of such a path; the walker refuses the path before
# anything binds (validator.cpp References). 1.5's parser refuses the spelling itself. Both: not allowed.

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('SELECT * FROM a.b.c.d');
----
false	true

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('SELECT a.b.c.f(1)');
----
false	true

query II
SELECT allowed, code IN ('parser', 'unsupported') FROM gatekeeper_validate('SELECT max(x) OVER () FROM a.b.c.d');
----
false	true
