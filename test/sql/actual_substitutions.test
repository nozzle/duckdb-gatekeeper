# name: test/sql/actual_substitutions.test
# description: Only selected replacements transfer caller ownership to trusted sibling identities.
# group: [gatekeeper]

require gatekeeper

statement ok
CREATE VIEW trusted_min AS SELECT arg_min(x,x) y FROM (VALUES ('a'),('b')) t(x);

statement ok
CALL gatekeeper_configure(blocked_functions := [{schema_path:['main'],name:'arg_min'}]);

query T
SELECT code FROM gatekeeper_validate('SELECT min(x), (SELECT y FROM trusted_min) FROM (VALUES (''a''),(''b'')) t(x)');
----
ok

query T
SELECT code FROM gatekeeper_validate('SELECT (SELECT y FROM trusted_min), min(x) FROM (VALUES (''a''),(''b'')) t(x)');
----
ok

query T
SELECT code FROM gatekeeper_validate('SELECT min(x COLLATE nocase), (SELECT y FROM trusted_min) FROM (VALUES (''a'')) t(x)');
----
forbidden

query T
SELECT code FROM gatekeeper_validate('SELECT min(x COLLATE nocase) OVER () FROM (VALUES (''a'')) t(x)');
----
forbidden

statement ok
CREATE VIEW trusted_epoch AS SELECT epoch(TIMESTAMP '2020-01-01') y;

statement ok
CALL gatekeeper_configure(blocked_functions := [{schema_path:['main'],name:'epoch'}]);

query T
SELECT code FROM gatekeeper_validate('SELECT date_part(''julian'', TIMESTAMP ''2020-01-01''), (SELECT y FROM trusted_epoch)');
----
ok

query T
SELECT code FROM gatekeeper_validate('SELECT date_part(''epoch'', TIMESTAMP ''2020-01-01''), (SELECT y FROM trusted_epoch)');
----
forbidden

statement ok
CALL gatekeeper_configure(blocked_functions := [{schema_path:['main'],name:'quantile_disc'}]);

query T
SELECT code FROM gatekeeper_validate('SELECT quantile(x, 0.5) OVER () FROM (VALUES (1)) t(x)');
----
forbidden
