require gatekeeper

query I
SELECT gatekeeper_validate('SELECT 1').allowed;
----
true

query T
SELECT gatekeeper_validate('DROP TABLE t').code;
----
unsupported

query I
SELECT gatekeeper_validate('SELECT md5(''x'')', blocked_functions := ['md5']).allowed;
----
false

query I
SELECT gatekeeper_validate('SELECT * FROM other.t', allowed_schemas := ['tenant']).allowed;
----
false

query I
CALL gatekeeper_configure(blocked_functions := ['md5']);
----
true

query I
SELECT gatekeeper_validate('SELECT md5(''x'')', blocked_functions := []).allowed;
----
false

statement ok
RESET gatekeeper_policy;

query I
SELECT gatekeeper_validate('SELECT md5(''x'')').allowed;
----
true

statement ok
SET lock_configuration=true;

statement error locked
CALL gatekeeper_configure();
